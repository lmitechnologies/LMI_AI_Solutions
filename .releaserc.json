{
  "branches": ["ais"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "uv version ${nextRelease.version} --no-sync && bash .github/workflows/scripts/rotate_prerelease.sh ${nextRelease.gitTag}",
        "successCmd": "bash .github/workflows/scripts/publish_release_notes.sh ${nextRelease.gitTag}"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "pyproject.toml",
          "uv.lock",
          "PRERELEASE.md",
          "docs/releases/*.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}